 "components": {
  "schemas": {
   "AuditRequest": {
    "properties": {
     "project": {
      "type": "string",
      "title": "Project"
     },
     "targets": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Targets"
     },
     "repetitions": {
      "type": "integer",
      "maximum": 20.0,
      "minimum": 1.0,
      "title": "Repetitions",
      "default": 1
     },
     "chaos": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Chaos"
     },
     "baseline": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Baseline"
     },
     "update_baseline": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Update Baseline"
     },
     "fail_on": {
      "type": "string",
      "enum": [
       "error",
       "warning",
       "never"
      ],
      "title": "Fail On",
      "default": "error"
     },
     "timeout_s": {
      "type": "number",
      "maximum": 3600.0,
      "exclusiveMinimum": 0.0,
      "title": "Timeout S",
      "default": 120.0
     },
     "agentic": {
      "type": "boolean",
      "title": "Agentic",
      "default": false
     },
     "scripted": {
      "type": "boolean",
      "title": "Scripted",
      "default": false
     },
     "request": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Request"
     }
    },
    "type": "object",
    "required": [
     "project"
    ],
    "title": "AuditRequest",
    "description": "Start a (gated) audit, or an agentic audit of one target."
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "JobKind": {
    "type": "string",
    "enum": [
     "audit",
     "agentic",
     "fix",
     "bench"
    ],
    "title": "JobKind",
