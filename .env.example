# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Crucible settings (all optional)
CRUCIBLE_HOME=.crucible
CRUCIBLE_LOG_LEVEL=INFO
CRUCIBLE_AGENT_MODEL=claude-sonnet-5-5
CRUCIBLE_JUDGE_MODEL=gemini-3-flash
# Live LLM runs (optional): run targets / Crucible's agents on another model, and cap spend
# CRUCIBLE_TARGET_LLM=gemini:gemini-3.5-flash-lite
# CRUCIBLE_AGENT_LLM=gemini:gemini-3.8-flash
# CRUCIBLE_LLM_BUDGET_USD=1.0
# CRUCIBLE_LLM_BUDGET_CALLS=500
# CRUCIBLE_USD_INR=88
