# Crucible: an agent network that QA-tests agent networks.
# The conductor plans an audit and delegates to specialists; deterministic work (lint, runs, judging, leak proof,
# chaos) happens in coded tools, judgement and explanation in LLM agents. project_dir / target arrive in sly_data.
{
    "commondefs": {
        "replacement_strings": {
            "evidence_rule": "Only report facts returned by your tools. Every claim must cite a finding id or audit id from a tool result. Never invent findings, numbers or agent names.",
            "specialist_style": "Answer the caller concisely in plain text: what you did, the key results (with ids), and anything the caller must decide next."
        }
    },
    "llm_config": {
        "class": "anthropic",
        "model_name": "claude-sonnet",
        "model_name": ${?CRUCIBLE_AGENT_MODEL},
        "temperature": 0.2
    },
    "max_steps": 200,
    "max_execution_seconds": 1800,
    "metadata": {
        "description": "Crucible audits a Neuro-SAN agent network: topology lint, scenario coverage, execution traces, leak proof, chaos and an evidence-backed report.",
        "tags": ["qa", "testing", "crucible"],
        "sample_queries": ["Audit the target thoroughly and write a report.", "Is any private sly_data leaking?"]
    },
    "tools": [
        {
            "name": "conductor",
            "function": {
                "description": "Plans and runs a Crucible quality audit of the agent network named in sly_data.target."
            },
            "instructions": """You are the Crucible audit conductor. You audit ONE target agent network (its name and project are already known to your tools).
Work in this order and keep it tight:
1. Ask topology_analyst for the static topology review.
2. Ask scenario_designer to check delegation-edge coverage and add scenarios for uncovered edges (at most 2 rounds).
3. Ask test_runner to run the audit including generated scenarios.
4. Ask investigator to confirm any leak/ findings and explain the root cause of the error-severity findings (at most 3).
5. If there are error or warning findings, ask fix_lead for verified fixes. Only recommend fixes it reports as ACCEPTED.
6. Ask regression_analyst whether anything is NEW compared with the baseline (the merge gate counts only new issues).
7. Optionally ask chaos_engineer for a chaos matrix when the user asks about resilience.
8. Ask report_writer to write the report, passing a 3-5 sentence executive summary.
Finish with a short verdict: SAFE TO MERGE or NOT SAFE TO MERGE, the top issues by id, and the report path.
{evidence_rule}""",
            "tools": ["topology_analyst", "scenario_designer", "test_runner", "investigator", "fix_lead", "regression_analyst", "chaos_engineer", "report_writer"],
            "allow": {"to_upstream": {"sly_data": ["crucible_audits", "crucible_report"]}}
        },
        {
            "name": "topology_analyst",
            "function": {
                "description": "Reviews the target network's static structure: cycles, unreachable agents, ambiguous routing descriptions, budgets and sly_data allow-lists.",
                "parameters": {"type": "object", "properties": {"request": {"type": "string", "description": "What to review or focus on"}}, "required": ["request"]}
            },
            "instructions": "You are Crucible's topology analyst. Call lint_network and explain the most important findings and why they matter at runtime. {evidence_rule} {specialist_style}",
            "tools": ["lint_network"]
        },
        {
            "name": "scenario_designer",
            "function": {
                "description": "Measures which delegation edges the existing scenarios exercise and designs new test scenarios for uncovered edges and risky behaviours.",
                "parameters": {"type": "object", "properties": {"request": {"type": "string", "description": "Coverage goal or behaviour to target"}}, "required": ["request"]}
            },
            "instructions": """You are Crucible's scenario designer. Call coverage_plan. For every uncovered edge write one realistic user request that should make the network take that route (use the 'to_description'), and set expect.route to the edge's route. You may add at most 2 adversarial scenarios (prompt injection in user text, or a private value in sly_data with expect.answer_not_contains that value). Use only synthetic data.
Submit them with save_scenarios as a JSON list following scenario_schema. If some are rejected, fix them once and resubmit. {evidence_rule} {specialist_style}""",
            "tools": ["coverage_plan", "save_scenarios"]
        },
        {
            "name": "test_runner",
            "function": {
                "description": "Executes the target's scenarios (optionally with chaos faults) and judges the traces into evidence-backed findings.",
                "parameters": {"type": "object", "properties": {"request": {"type": "string", "description": "What to run, e.g. include generated scenarios, chaos faults"}}, "required": ["request"]}
            },
            "instructions": "You are Crucible's test runner. Call run_audit (include_generated true unless told otherwise; repetitions 3 unless told otherwise, because LLM behaviour varies between runs; chaos only if asked). Report the audit_id and the findings grouped by severity with their ids. {evidence_rule} {specialist_style}",
            "tools": ["run_audit"]
        },
        {
            "name": "investigator",
            "function": {
                "description": "Investigates audit findings: confirms private sly_data exposures and explains root causes of specific findings from trace evidence.",
                "parameters": {"type": "object", "properties": {"request": {"type": "string", "description": "Leak question and/or finding ids to explain"}}, "required": ["request"]}
            },
            "instructions": """You are Crucible's investigator. For leaks call leak_report and explain each exposure: the sly_data key (never the value), where it surfaced, which agent emitted it first, and the fix. For a finding id call finding_evidence and explain the root cause in 2-4 sentences grounded in the evidence and delegation path, naming the agent and instruction or description to change. {evidence_rule} {specialist_style}""",
            "tools": ["leak_report", "finding_evidence"]
        },
        {
            "name": "fix_lead",
            "function": {
                "description": "Produces verified fixes: gets proposals from fix_proposer and has fix_verifier test each one, iterating on rejections.",
                "parameters": {"type": "object", "properties": {"request": {"type": "string", "description": "Which findings to fix"}}, "required": ["request"]}
            },
            "instructions": """You are Crucible's fix lead and you run a critic loop. 1) Ask fix_proposer for proposals. 2) Ask fix_verifier to verify them. 3) For each REJECTED non-manual proposal, send the rejection reason back to fix_proposer once for refined ops, then verify again. Stop after 2 rounds. Report only verifier-ACCEPTED fixes as fixes; list manual and rejected ones separately with reasons. {evidence_rule} {specialist_style}""",
            "tools": ["fix_proposer", "fix_verifier"]
        },
        {
            "name": "fix_proposer",
            "function": {
                "description": "Proposes concrete configuration fixes (instructions, descriptions, edges, limits, sly_data allow-lists) for an audit's findings.",
                "parameters": {"type": "object", "properties": {"request": {"type": "string", "description": "Which findings to fix, or a verifier rejection to address"}}, "required": ["request"]}
            },
            "instructions": "You are Crucible's fix proposer. Call propose_fixes and present each proposal with its id, the finding it targets and why it should work. Mark manual (code-change) proposals clearly. If you were given a verifier rejection, explain how the refined ops address it. {evidence_rule} {specialist_style}",
            "tools": ["propose_fixes"]
        },
        {
            "name": "fix_verifier",
            "function": {
                "description": "Critic: verifies proposed fixes by re-auditing a patched copy of the network; accepts a fix only if its finding disappears and nothing new breaks.",
                "parameters": {"type": "object", "properties": {"request": {"type": "string", "description": "Proposal ids to verify (default: all) or refined ops"}}, "required": ["request"]}
            },
            "instructions": "You are Crucible's fix verifier and you are strict. Call verify_fixes. Report each verdict (ACCEPTED or REJECTED with the reason and any new findings). Never accept a fix the tool rejected. {evidence_rule} {specialist_style}",
            "tools": ["verify_fixes"]
        },
        {
            "name": "regression_analyst",
            "function": {
                "description": "Compares the latest audit with the target's baseline and reports new, fixed and unchanged findings plus metric regressions.",
                "parameters": {"type": "object", "properties": {"request": {"type": "string", "description": "Baseline label to compare with (default main)"}}, "required": ["request"]}
            },
            "instructions": "You are Crucible's regression analyst. Call regression_diff. Say clearly whether anything is NEW versus the baseline (that decides the merge gate), what got fixed, and any metric regressions. If there is no baseline yet, say so. {evidence_rule} {specialist_style}",
            "tools": ["regression_diff"]
        },
        {
            "name": "chaos_engineer",
            "function": {
                "description": "Runs the chaos matrix (tool exceptions, empty, malformed and instruction-injected outputs) and reports which failures break the network.",
                "parameters": {"type": "object", "properties": {"request": {"type": "string", "description": "Resilience question or specific fault profiles"}}, "required": ["request"]}
            },
            "instructions": "You are Crucible's chaos engineer. Call chaos_matrix (profiles optional, e.g. exception:tool_name). Report the resilience score and every non-resilient profile with its new findings. {evidence_rule} {specialist_style}",
            "tools": ["chaos_matrix"]
        },
        {
            "name": "report_writer",
            "function": {
                "description": "Writes the final audit report file for all audits of this session, with an executive summary.",
                "parameters": {"type": "object", "properties": {"request": {"type": "string", "description": "Executive summary to include"}}, "required": ["request"]}
            },
            "instructions": "You are Crucible's report writer. Call render_report with format markdown and the executive summary you were given. Return the report path. {evidence_rule}",
            "tools": ["render_report"]
        },
        {
            "name": "lint_network",
            "function": {"description": "Runs Crucible's static lint rules and Neuro-SAN's validators on the target network.",
                "parameters": {"type": "object", "properties": {"target": {"type": "string", "description": "Target name (optional; defaults to the session target)"}}}},
            "class": "crucible.integrations.neurosan.agent_tools.LintNetwork"
        },
        {
            "name": "coverage_plan",
            "function": {"description": "Runs existing scenarios and reports delegation-edge coverage with uncovered edges and the scenario schema.",
                "parameters": {"type": "object", "properties": {"target": {"type": "string", "description": "Target name (optional)"}}}},
            "class": "crucible.integrations.neurosan.agent_tools.CoveragePlan"
        },
        {
            "name": "save_scenarios",
            "function": {"description": "Validates scenarios (JSON list following scenario_schema) and stores the valid ones for the next audit.",
                "parameters": {"type": "object", "properties": {"scenarios": {"type": "string", "description": "JSON list of scenario objects"}}, "required": ["scenarios"]}},
            "class": "crucible.integrations.neurosan.agent_tools.SaveScenarios"
        },
        {
            "name": "run_audit",
            "function": {"description": "Executes scenarios against the target and judges traces into findings; returns audit_id and findings.",
                "parameters": {"type": "object", "properties": {
                    "include_generated": {"type": "boolean", "description": "Also run agent-designed scenarios"},
                    "chaos": {"type": "string", "description": "Comma-separated fault profiles, e.g. exception:order_status"},
                    "repetitions": {"type": "integer", "description": "Runs per scenario (default 1)"}}}},
            "class": "crucible.integrations.neurosan.agent_tools.RunAudit"
        },
        {
            "name": "finding_evidence",
            "function": {"description": "Returns masked evidence, delegation path and answer for one finding id.",
                "parameters": {"type": "object", "properties": {
                    "finding_id": {"type": "string", "description": "8-character finding id"},
                    "audit_id": {"type": "string", "description": "Audit id (optional; defaults to latest)"}}, "required": ["finding_id"]}},
            "class": "crucible.integrations.neurosan.agent_tools.FindingEvidence"
        },
        {
            "name": "leak_report",
            "function": {"description": "Lists sly_data leak findings of an audit with masked evidence and remediation.",
                "parameters": {"type": "object", "properties": {"audit_id": {"type": "string", "description": "Audit id (optional; defaults to latest)"}}}},
            "class": "crucible.integrations.neurosan.agent_tools.LeakReport"
        },
        {
            "name": "propose_fixes",
            "function": {"description": "Returns deterministic fix proposals (patch ops) for the findings of an audit.",
                "parameters": {"type": "object", "properties": {"audit_id": {"type": "string", "description": "Audit id (optional; defaults to latest)"}}}},
            "class": "crucible.integrations.neurosan.agent_tools.ProposeFixes"
        },
        {
            "name": "verify_fixes",
            "function": {"description": "Applies proposals to a temporary copy of the network, re-runs the audit and returns accept/reject verdicts.",
                "parameters": {"type": "object", "properties": {
                    "proposal_ids": {"type": "string", "description": "Comma-separated proposal ids (optional; default all)"},
                    "ops": {"type": "string", "description": "Optional JSON list of refined patch ops for ONE proposal id"},
                    "audit_id": {"type": "string", "description": "Audit id (optional; defaults to latest)"}}}},
            "class": "crucible.integrations.neurosan.agent_tools.VerifyFixes"
        },
        {
            "name": "regression_diff",
            "function": {"description": "Diffs an audit against a baseline label: new / fixed / persisting findings and metric regressions.",
                "parameters": {"type": "object", "properties": {
                    "baseline": {"type": "string", "description": "Baseline label (default main)"},
                    "audit_id": {"type": "string", "description": "Audit id (optional; defaults to latest)"}}}},
            "class": "crucible.integrations.neurosan.agent_tools.RegressionDiff"
        },
        {
            "name": "chaos_matrix",
            "function": {"description": "Runs baseline plus fault profiles on coded tools and reports which faults introduce new findings.",
                "parameters": {"type": "object", "properties": {"profiles": {"type": "string", "description": "Comma-separated fault profiles (optional)"}}}},
            "class": "crucible.integrations.neurosan.agent_tools.ChaosMatrix"
        },
        {
            "name": "render_report",
            "function": {"description": "Writes the markdown report for this session's audits and returns its path.",
                "parameters": {"type": "object", "properties": {
                    "summary": {"type": "string", "description": "Executive summary"},
                    "format": {"type": "string", "description": "markdown | json | sarif"}}}},
            "class": "crucible.integrations.neurosan.agent_tools.RenderReport"
        }
    ]
}
