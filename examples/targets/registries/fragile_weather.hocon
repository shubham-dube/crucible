# SEEDED DEFECT: the forecast tool fails (upstream outage) and the agent answers confidently anyway.
{
    "llm_config": {"class": "crucible.integrations.neurosan.scripted_llm.ScriptedChatModel", "script_path":  "fragile_weather.yaml"},
    "max_steps": 30,
    "max_execution_seconds": 30,
    "tools": [
        {
            "name": "weather_desk",
            "function": {"description": "Answers weather questions for Indian cities."},
            "instructions": "[weather_desk] Use the forecast tool and answer the user's weather question.",
            "tools": ["forecast"]
        },
        {
            "name": "forecast",
            "function": {
                "description": "Returns tomorrow's forecast for a city from the upstream weather service.",
                "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name"}}, "required": ["city"]}
            },
            "class": "forecast.Forecast"
        }
    ]
}
