# Crucible API + worker (also usable as a CLI image: `docker run ... crucible audit /projects/x`).
FROM python:3.13-slim AS build
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
RUN pip install --no-cache-dir uv==0.11.32
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH=/app/.venv/bin:$PATH \
    CRUCIBLE_HOME=/data \
    CRUCIBLE_PROJECTS=zoo=/app/examples/targets
RUN useradd --create-home --uid 10001 crucible && mkdir /data && chown crucible:crucible /data
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY examples ./examples
USER crucible
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/v1/health', timeout=3)"
CMD ["crucible", "serve", "--host", "0.0.0.0", "--port", "8765"]
