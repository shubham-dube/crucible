# Crucible dashboard (Next.js standalone output).
FROM node:22-slim AS build
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /web
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web ./
RUN pnpm build

FROM node:22-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0 \
    CRUCIBLE_API_URL=http://api:8765
WORKDIR /web
RUN useradd --create-home --uid 10001 crucible
COPY --from=build --chown=crucible /web/.next/standalone ./
COPY --from=build --chown=crucible /web/.next/static ./.next/static
USER crucible
EXPOSE 3000
CMD ["node", "server.js"]
